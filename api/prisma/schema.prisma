// schema.prisma
// Frame Clash - Core Database Schema v3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum Role {
  USER
  ADMIN
}

// 3 Niveles de Dificultad
enum Difficulty {
  EASY // Nivel 1: Datos directos y obvios (Director, año, actor principal)
  MEDIUM // Nivel 2: Contexto (Estudio, país, saga, duración, taquilla aprox)
  HARD // Nivel 3: Detalle experto (Presupuesto exacto, fecha exacta, fotogramas, tagline, keywords)
}

enum Rarity {
  COMMON // Común (Gris)
  UNCOMMON // Inusual (Verde)
  RARE // Rara (Celeste)
  EPIC // Épica (Violeta)
  LEGENDARY // Legendaria (Naranja / Dorado)
}

enum GameMode {
  CLASSIC // Trivia Clásica (10 preguntas)
  ROGUELITE // Roguelite Infinito por tandas con puntaje mínimo
  DOMINATION // Dominio por Categoría (10 nodos progresivos)
  DRAFT // Modo Draft (3 rondas con mazo de 4 power-ups)
  PVP_ASYNC // Duelo 1v1 Asincrónico por ELO
  PVP_LIVE // Duelo 1v1 en Tiempo Real (3 rondas)
  BATTLE_ROYALE // Battle Royale de 10 jugadores
}

// Capas de Power-Ups
enum TriggerType {
  CURRENT_QUESTION // Efecto inmediato en la pregunta actual
  NEXT_QUESTION // Efecto diferido para la próxima pregunta
  PASSIVE // Pasivo (modificador permanente en la partida)
  ROUND // Manipulación de la ronda / mazo
}

enum ConditionType {
  NONE // Sin condición (funciona siempre - típico en Legendarias/Míticas)
  ON_WIN // "Si aciertas la pregunta actual..."
  ON_LOSS // "Si fallas la pregunta actual..."
  IS_CATEGORY // "Solo si la pregunta ES de Categoría X..."
  IS_NOT_CATEGORY // "Solo si la pregunta NO ES de Categoría X..."
}

enum ActionType {
  REMOVE_OPTION // Elimina 1 o 2 opciones incorrectas
  EXTRA_CHANCE // Segunda oportunidad si fallas (1 o 2 intentos extra)
  REVEAL_ANSWER // Revela la respuesta correcta
  MULTIPLY_TIME // Multiplicador de bonus de tiempo (+10%, x2, x3)
  MULTIPLY_SCORE // Multiplicador de puntos base (+10%, x2, x3)
  GLOBAL_MULTIPLIER // Multiplicador global (x2, x3 total)
  CHANGE_CATEGORY // Cambiar pregunta por otra categoría
  ADD_QUESTION // +1 pregunta en la ronda
  REMOVE_QUESTION // -1 pregunta en la ronda
}

enum MissionFrequency {
  DAILY
  WEEKLY
  SEASONAL
}

enum MissionType {
  PLAY_GAMES
  EARN_COINS
  SCORE_POINTS
  CORRECT_ANSWERS
  OPEN_PACKS
  PLAY_CATEGORY
}

enum RewardType {
  COINS
  GEMS
  STARDUST
  PACK
  CARD
}

// ==========================================
// 2. MODELOS PRINCIPALES
// ==========================================

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  password String?
  image    String?
  role     Role    @default(USER)

  // ECONOMÍA Y PROGRESO
  coins    Int @default(0) // Monedas para sobres y tienda
  gems     Int @default(0) // Moneda premium
  stardust Int @default(0) // Polvo Estelar (obtenido de duplicados para crafteo)
  level    Int @default(1) // Nivel de cuenta
  xp       Int @default(0) // Experiencia acumulada

  // COMPETITIVO & PERFIL
  eloRating         Int       @default(1000)
  rankTier          String    @default("bronze")
  profileBackground String?
  profileTitle      String?
  loginStreak       Int       @default(0)
  lastLogin         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELACIONES
  sessions           GameSession[]
  inventory          UserCard[]
  missions           UserMission[]
  collections        UserCollection[]
  dominationProgress DominationProgress[]
  rogueliteProgress  RogueliteProgress?
}

model Category {
  id     String  @id @default(cuid())
  key    String  @unique // Ej: 'ACTION', 'HORROR', 'ERA_BLOCKBUSTER_POP'
  name   String? // Nombre para mostrar (ej: "Terror", "Años 80")
  slug   String? // Slug para URLs (ej: "terror")
  icon   String? // Emoji o icono (ej: "👻", "💥")
  type   String? // 'genre' | 'decade' | 'theme'
  tmdbId Int?

  createdAt DateTime @default(now())

  cardsWithPowerUp   Card[]               @relation("PowerUpCategory")
  cards              Card[]               @relation("CardCategories")
  dominationProgress DominationProgress[]
}

model Card {
  id            String  @id @default(cuid())
  tmdbId        Int     @unique
  title         String
  originalTitle String?
  year          Int
  posterPath    String?
  backdropPath  String?
  rarity        Rarity  @default(COMMON)
  borderColor   String?

  // STATS DE CARTA (Derivados de TMDB)
  atk Int @default(50) // Basado en vote_average (Rating)
  def Int @default(50) // Basado en popularity
  spd Int @default(50) // Basado en runtime (más corta = más rápida)
  box Int @default(50) // Basado en revenue (recaudación)
  crt Int @default(50) // Stat general compuesto

  // Categorías de la película (1 por década + 1 o 2 por género/tema, máx 3)
  categories Category[] @relation("CardCategories")

  // === MATRIZ DE POWER-UPS (El Sistema de 4 Capas) ===
  powerUpTrigger   TriggerType?
  powerUpCondition ConditionType?
  powerUpAction    ActionType?
  powerUpValue     Int? // Valor numérico (ej: 1 para "quita 1 opción", 2 para "x2 bonus")

  // Categoría objetivo si la condición es IS_CATEGORY o IS_NOT_CATEGORY
  targetCategoryId String?
  targetCategory   Category? @relation("PowerUpCategory", fields: [targetCategoryId], references: [id])

  isUniqueLegendary Boolean @default(false) // TRUE si es recompensa única de Dominio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owners      UserCard[]
  collections Collection[] @relation("CollectionCards")
  questions   Question[]
}

// INVENTARIO DEL JUGADOR
model UserCard {
  id     String @id @default(cuid())
  userId String
  cardId String

  quantity      Int        @default(1) // Cantidad de copias
  level         Int        @default(1) // Nivel de la carta (1, 2, 3) por duplicados
  isFavorite    Boolean    @default(false)
  equippedModes GameMode[] // Modos donde está equipada

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId])
}

model Question {
  id            String     @id @default(cuid())
  text          String
  correctAnswer String
  options       String[] // 4 opciones mezcladas
  difficulty    Difficulty

  // METADATOS DE TRIVIA (24 tipos en 5 bloques)
  block      Int? // 1: Elenco/Dirección, 2: Fechas, 3: Economía, 4: Cinéfilo, 5: Visual
  typeNumber Int? // 1 a 24
  imageUrl   String? // Para preguntas visuales (fotogramas / póster ciego)
  isManual   Boolean @default(false)

  timesServed  Int @default(0)
  timesCorrect Int @default(0)

  cardId     String?
  card       Card?    @relation(fields: [cardId], references: [id])
  categories String[] // Keys de categorías a las que aplica (ej: ['ACTION', 'ERA_BLOCKBUSTER_POP'])

  createdAt DateTime @default(now())
}

// ==========================================
// 3. HISTORIAL, PARTIDAS Y PROGRESIÓN
// ==========================================

model GameSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  mode            GameMode @default(CLASSIC)
  score           Int      @default(0) // Puntos totales (10.000 base + ms restantes)
  correctCount    Int      @default(0)
  totalQuestions  Int      @default(10)
  coinsEarned     Int      @default(0)
  xpEarned        Int      @default(0)
  stars           Int? // 1-3 estrellas
  avgResponseTime Int      @default(0) // Tiempo promedio en ms

  auditLog Json?

  createdAt DateTime @default(now())
}

// PROGRESO DE DOMINIO POR CATEGORÍA (10 nodos por categoría)
model DominationProgress {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  nodeNumber Int // 1 al 10

  stars     Int       @default(0) // 0 a 3 estrellas
  bestScore Int       @default(0)
  completed Boolean   @default(false)
  claimedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, nodeNumber])
}

// PROGRESO ROGUELITE
model RogueliteProgress {
  id                   String @id @default(cuid())
  userId               String @unique
  bestWave             Int    @default(0) // Mejor tanda alcanzada
  bestScore            Int    @default(0) // Mejor puntaje acumulado
  totalRuns            Int    @default(0)
  unlockedPowerUpSlots Int    @default(1) // 1 a 5 slots
  stats                Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// MISIONES
model UserMission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  frequency    MissionFrequency
  type         MissionType
  title        String
  targetValue  Int
  currentValue Int              @default(0)
  isCompleted  Boolean          @default(false)
  rewardCoins  Int
  rewardXp     Int              @default(50)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// 4. COLECCIONES Y ÁLBUMES
// ==========================================

model Collection {
  id          String  @id @default(cuid())
  name        String  @unique // Ej: "Saga Star Wars", "Clásicos de Terror"
  description String?

  rewardType  RewardType @default(COINS)
  rewardValue String // Valor o identificador del premio
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards        Card[]           @relation("CollectionCards")
  userProgress UserCollection[]
}

model UserCollection {
  id           String @id @default(cuid())
  userId       String
  collectionId String

  isClaimed Boolean   @default(false)
  claimedAt DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, collectionId])
}
